---
import "../styles/global.css";
import WorldMap from "../components/WorldMap/WorldMap.astro";
import MapSky from "../components/MapSky/MapSky.astro";
import MapIntro from "../components/MapIntro/MapIntro.astro";
import MapNode from "../components/MapNode/MapNode.astro";
import CodyMcCodeface from "../components/CodyMcCodeface/CodyMcCodeface.astro";
import MapPiece from "../components/MapPiece/MapPiece.astro";
import MapPath from "../components/MapPath/MapPath.astro";
import MapDialog from "../components/MapDialog/MapDialog.astro";
import PowerBundle from "../components/PowerBundle/PowerBundle.astro";
import gsapLogo from "../assets/logos/gsap.svg";
import webflowLogo from "../assets/logos/webflow.svg";
import codeTvLogo from "../assets/logos/codetv.svg";
import html5Logo from "../assets/logos/html5.svg";
import javascriptLogo from "../assets/logos/javascript.svg";
import cssLogo from "../assets/logos/css.svg";
import astroLogo from "../assets/logos/astro.svg";
import MapGrass from "../components/MapGrass/MapGrass.astro";

const eastPowerLogos = [
  { name: "GSAP", src: gsapLogo.src },
  { name: "Webflow", src: webflowLogo.src },
  { name: "CodeTV", src: codeTvLogo.src },
];

const westPowerLogos = [
  { name: "HTML5", src: html5Logo.src },
  { name: "JavaScript", src: javascriptLogo.src },
  { name: "CSS", src: cssLogo.src },
  { name: "Astro", src: astroLogo.src },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>
      CodeTV Web Dev Challenge S3.E5 Tribute - A CodeTV x Webflow Hackathon
      Entry
    </title>
  </head>
  <body>
    <WorldMap>
      <MapSky />
      <CodyMcCodeface />
      <MapIntro>
        <MapPiece partial={true} name="home">
          <MapNode
            classMods="node-x-mid node-y-top"
            nodeType="start"
            ariaLabel="Map home section, starting node"
          />
        </MapPiece>
      </MapIntro>
      <MapPiece name="top">
        <MapGrass />
        <MapPath type="north-to-south" />
        <MapPath type="east-to-west" />
        <MapNode
          classMods="node-x-mid node-y-top"
          nodeType="entry"
          ariaLabel="Map top section, northmost node"
        />
        <MapNode
          classMods="node-x-mid node-y-mid"
          nodeType="junction"
          ariaLabel="Map top section, central node"
        />
        <MapNode
          classMods="node-x-left node-y-mid"
          nodeType="branch-left"
          ariaLabel="Map top section, west node"
        />
        <PowerBundle
          id="code-power-bundle"
          classMods="power-bundle-x-left power-bundle-y-mid"
          logos={westPowerLogos}
        />
        <MapNode
          classMods="node-x-right node-y-mid"
          nodeType="branch-right"
          ariaLabel="Map top section, east node"
        />
        <PowerBundle
          id="community-power-bundle"
          classMods="power-bundle-x-right power-bundle-y-mid"
          logos={eastPowerLogos}
        />
        <MapNode
          classMods="node-x-mid node-y-bottom"
          nodeType="stop"
          ariaLabel="Map top section, southmost node"
        />
      </MapPiece>
      <MapPiece name="bottom" initiallyHidden={true}>
        <MapGrass />
        <MapNode
          classMods="node-x-mid node-y-top"
          nodeType="entry"
          ariaLabel="Map bottom section, northmost node"
        />
      </MapPiece>
      <MapDialog />
    </WorldMap>
  </body>
</html>
