---
import '../styles/global.css';
import WorldMap from '../components/WorldMap/WorldMap.astro';
import MapSky from '../components/MapSky/MapSky.astro';
import MapIntro from '../components/MapIntro/MapIntro.astro';
import MapNode from '../components/MapNode/MapNode.astro';
import CodyMcCodeface from '../components/CodyMcCodeface/CodyMcCodeface.astro';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>CodeTV Web Dev Challenge S3.E5 Tribute - A CodeTV x Webflow Hackathon Entry</title>
	</head>
	<body>
		<WorldMap>
			<MapSky />
			<MapIntro>
				<MapNode slot="home-node" classMods="node-start" nodeType="handoff" ariaLabel="Map home section, starting node" />
			</MapIntro>
			<CodyMcCodeface />
		</WorldMap>
	</body>
</html>
