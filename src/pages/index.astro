---
import "../styles/global.css";
import WorldMap from "../components/WorldMap/WorldMap.astro";
import MapSky from "../components/MapSky/MapSky.astro";
import MapIntro from "../components/MapIntro/MapIntro.astro";
import MapNode from "../components/MapNode/MapNode.astro";
import CodyMcCodeface from "../components/CodyMcCodeface/CodyMcCodeface.astro";
import MapPiece from "../components/MapPiece/MapPiece.astro";
import MapPath from "../components/MapPath/MapPath.astro";
import MapDialog from "../components/MapDialog/MapDialog.astro";
import PowerBundle from "../components/PowerBundle/PowerBundle.astro";
import gsapLogo from "../assets/logos/gsap.svg";
import webflowLogo from "../assets/logos/webflow.svg";
import codeTvLogo from "../assets/logos/codetv.svg";
import html5Logo from "../assets/logos/html5.svg";
import javascriptLogo from "../assets/logos/javascript.svg";
import cssLogo from "../assets/logos/css.svg";
import astroLogo from "../assets/logos/astro.svg";
import MapGrass from "../components/MapGrass/MapGrass.astro";
import MapWater from "../components/MapWater/MapWater.astro";
import MapCliff from "../components/MapCliff/MapCliff.astro";
import MapBush from "../components/MapBush/MapBush.astro";
import MapLabel from "../components/MapLabel/MapLabel.astro";
import StudioRoom from "../components/studio/StudioRoom.astro";
import StudioArchitecture from "../components/studio/StudioArchitecture.astro";
import StudioWindow from "../components/studio/StudioWindow.astro";
import StudioCurtainedDoor from "../components/studio/StudioCurtainedDoor.astro";
import StudioSofa from "../components/studio/StudioSofa.astro";
import StudioRug from "../components/studio/StudioRug.astro";
import StudioCoffeeTable from "../components/studio/StudioCoffeeTable.astro";
import StudioSign from "../components/studio/StudioSign.astro";
import StudioAvatar from "../components/studio/StudioAvatar.astro";
import StudioWordCloud from "../components/studio/StudioWordCloud.astro";
import StudioKonami from "../components/studio/StudioKonami.astro";

const eastPowerLogos = [
  { name: "GSAP", src: gsapLogo.src },
  { name: "Webflow", src: webflowLogo.src },
  { name: "CodeTV", src: codeTvLogo.src },
];

const westPowerLogos = [
  { name: "HTML5", src: html5Logo.src },
  { name: "JavaScript", src: javascriptLogo.src },
  { name: "CSS", src: cssLogo.src },
  { name: "Astro", src: astroLogo.src },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      if ("scrollRestoration" in history) history.scrollRestoration = "manual";

      window.scrollTo(0, 0);
      window.addEventListener("pageshow", () => window.scrollTo(0, 0));
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>
      CodeTV Web Dev Challenge S3.E5 Tribute - A CodeTV x Webflow Hackathon
      Entry
    </title>
  </head>
  <body>
    <WorldMap>
      <MapSky />
      <CodyMcCodeface />
      <MapIntro>
        <MapPiece partial={true} name="home">
          <MapNode
            classMods="node-x-mid node-y-top"
            nodeType="start"
            ariaLabel="Map home section, starting node"
          />
        </MapPiece>
      </MapIntro>
      <MapPiece name="top">
        <MapGrass />
        <MapWater />
        <MapCliff />
        <MapBush pos="top-left" />
        <MapBush pos="top-right" />
        <MapLabel id="studio" />
        <MapPath type="north-to-south" />
        <MapPath type="east-to-west" />
        <MapNode
          classMods="node-x-mid node-y-top"
          nodeType="entry"
          ariaLabel="Map top section, northmost node"
        />
        <MapNode
          classMods="node-x-mid node-y-mid"
          nodeType="junction"
          ariaLabel="Map top section, central node"
        />
        <MapNode
          classMods="node-x-left node-y-mid"
          nodeType="branch-left"
          ariaLabel="Map top section, west node"
        />
        <PowerBundle
          id="code-power-bundle"
          classMods="power-bundle-x-left power-bundle-y-mid"
          logos={westPowerLogos}
        />
        <MapNode
          classMods="node-x-right node-y-mid"
          nodeType="branch-right"
          ariaLabel="Map top section, east node"
        />
        <PowerBundle
          id="community-power-bundle"
          classMods="power-bundle-x-right power-bundle-y-mid"
          logos={eastPowerLogos}
        />
        <MapNode
          classMods="node-x-mid node-y-bottom"
          nodeType="stop"
          ariaLabel="Map top section, southmost node"
        />
      </MapPiece>
      <MapPiece name="bottom" initiallyHidden={true}>
        <StudioRoom>
          <StudioArchitecture wall="top" />
          <StudioArchitecture wall="left" />
          <StudioArchitecture wall="right" />
          <StudioArchitecture wall="bottom" />
          <StudioWindow />
          <StudioCurtainedDoor />
          <StudioSign />
          <StudioSofa variant="green" label="Deep green sofa" />
          <StudioSofa variant="orange" label="Bright orange sofa" />
          <StudioRug />
          <StudioCoffeeTable />
          <MapNode
            classMods="node-x-mid studio-node studio-node--entry"
            nodeType="entry"
            ariaLabel="CodeTV Studio, northmost node"
          />
          <StudioAvatar name="Jason" src="/jason.png" position="jason" />
          <MapNode
            classMods="node-x-mid studio-node studio-node--mid"
            nodeType="mid"
            ariaLabel="CodeTV Studio, central node"
          />
          <StudioAvatar name="Cassie" src="/cassie.png" position="cassie" />
          <MapNode
            classMods="studio-node studio-node--west"
            nodeType="west"
            ariaLabel="CodeTV Studio, Team Keyframers node"
          />
          <p class="studio-node-label studio-node-label--west">
            Team Keyframers
          </p>
          <StudioAvatar
            name="David"
            src="/t1-keyframers-david.png"
            position="david"
          />
          <StudioAvatar
            name="Steven"
            src="/t1-keyframers-steven.png"
            position="steven"
          />
          <MapNode
            classMods="studio-node studio-node--east"
            nodeType="east"
            ariaLabel="CodeTV Studio, Team Osmo node"
          />
          <p class="studio-node-label studio-node-label--east">Team Osmo</p>
          <StudioAvatar
            name="Ilja"
            src="/t2-osmo-ilja-v-art.png"
            position="ilja"
          />
          <StudioAvatar
            name="Dennis"
            src="/t2-osmo-dennis.png"
            position="dennis"
          />
          <MapNode
            classMods="node-x-mid studio-node studio-node--south"
            nodeType="south"
            ariaLabel="CodeTV Studio, Team U.S. Mint and Treasury node"
          />
          <p class="studio-node-label studio-node-label--south">
            Team U.S. Mint &amp; Treasury
          </p>
          <StudioAvatar
            name="Henry"
            src="/t3-ustandm-henry.png"
            position="henry"
          />
          <StudioWordCloud />
          <StudioKonami />
        </StudioRoom>
      </MapPiece>
      <MapDialog />
    </WorldMap>
  </body>
</html>
