---
import "./MapDialog.css";

interface Props {
  eyebrow?: string;
  title?: string;
  message?: string;
  continueLabel?: string;
}

const {
  eyebrow = "Player Message",
  title = "",
  message = "",
  continueLabel = "Continue",
}: Props = Astro.props;
---

<dialog class="map-dialog" data-map-dialog aria-labelledby="map-dialog-title">
  <div class="map-dialog__panel">
    <div class="map-dialog__rivets" aria-hidden="true"></div>

    <button
      class="map-dialog__close"
      type="button"
      aria-label="Close dialog"
      data-map-dialog-close
    >
      <span aria-hidden="true">×</span>
    </button>

    <div class="map-dialog__badge" aria-hidden="true">
      <span>!</span>
    </div>

    <div class="map-dialog__content">
      <p class="map-dialog__eyebrow" data-map-dialog-eyebrow>{eyebrow}</p>
      <h2 id="map-dialog-title" data-map-dialog-title>{title}</h2>
      <p class="map-dialog__message" data-map-dialog-message>{message}</p>

      <button class="map-dialog__continue" type="button" data-map-dialog-close>
        <span>{continueLabel}</span>
        <span class="map-dialog__arrow" aria-hidden="true">▶</span>
      </button>
    </div>
  </div>
</dialog>

<script>
  import "./MapDialog.js";
</script>
