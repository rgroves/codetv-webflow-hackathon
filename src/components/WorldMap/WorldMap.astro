---
import './WorldMap.css';
---
	<section class="world-map">
		<div class="map-sky">
			<div class="map-sun"></div>
			<div class="map-cloud map-cloud-left"></div>
			<div class="map-cloud map-cloud-right"></div>
		</div>
		<header class="map-intro">
			<p class="map-kicker">World 3-5</p>
			<h1>A Tribute to CodeTV's Web Dev Challenge</h1>
			<p class="map-caption">Movement Options: Use WASD or the arrow keys to move. Scroll to move up/down. Click a connected node to send Cody there.</p>
		</header>
		<div style="position: relative;">
			<button class="node node-start" data-node="start" type="button" aria-label="Start node, move down to begin"></button>
		</div>
	</section>
