---
import "./StudioKonami.css";
---

<aside
  class="studio-konami"
  data-studio-konami
  aria-hidden="true"
>
  <svg
    class="studio-konami__logo"
    viewBox="0 0 908 765"
    role="img"
    aria-labelledby="studio-konami-title"
  >
    <title id="studio-konami-title">Classic Konami emblem</title>
    <!-- Classic 1986 emblem geometry, without its wordmark. -->
    <g transform="translate(0 -52.362)">
      <g transform="matrix(2.2850091 0 0 2.2850091 -732.71664 -2182.1007)">
      <path
        class="studio-konami__ribbon studio-konami__ribbon--orange"
          d="m637.97 977.879-16.864 47.008c-28.136 72.679-77.85 58.223-115.846 70.064-26.136 8.145-40.882 35.687-51.886 65.016l-13.453 41.898H320.662l19.384-53.863c26.74-67.69 83.402-50.627 120.584-68.366 24.247-11.568 37.536-35.482 44.217-60.417l14.257-41.34Z"
      />
      <path
        class="studio-konami__ribbon studio-konami__ribbon--red"
          d="m399.739 1311.151 16.864-47.008c28.136-72.679 76.782-58.184 114.27-71.548 26.388-9.408 39.167-25.43 53.462-63.532l13.453-41.898h120.016l-19.401 52.932c-35.085 73.042-83.219 49.656-120.431 67.332-22.227 10.558-39.321 40.304-46.002 65.239l-13.365 38.483Z"
      />
      </g>
    </g>
  </svg>
</aside>

<script>
  import "./StudioKonami.js";
</script>
