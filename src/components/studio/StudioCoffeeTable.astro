---
import "./StudioCoffeeTable.css";
---

<section class="studio-coffee-table" aria-label="Wood coffee table">
  <div class="studio-coffee-table__top"></div>
  <div class="studio-coffee-table__leg studio-coffee-table__leg--1"></div>
  <div class="studio-coffee-table__leg studio-coffee-table__leg--2"></div>
  <div class="studio-coffee-table__leg studio-coffee-table__leg--3"></div>
  <div class="studio-coffee-table__leg studio-coffee-table__leg--4"></div>
  <div class="studio-coffee-table__vase" aria-hidden="true"></div>
  <div class="studio-coffee-table__sprig studio-coffee-table__sprig--1" aria-hidden="true"></div>
  <div class="studio-coffee-table__sprig studio-coffee-table__sprig--2" aria-hidden="true"></div>
  <div class="studio-coffee-table__sprig studio-coffee-table__sprig--3" aria-hidden="true"></div>
</section>
