---
import "./MapPiece.css";

interface Props {
  name: string;
  partial?: boolean;
  initiallyHidden?: boolean;
}

const { name, partial = false, initiallyHidden = false }: Props = Astro.props;
---

<>
  {
    partial ? (
      <div class="map-piece-partial" data-map-piece={name}>
        <slot />
      </div>
    ) : (
      <section class="map-section" hidden={initiallyHidden}>
        <div class="map-piece" data-map-piece={name}>
          <div class="piece-frame">
            <slot />
          </div>
        </div>
      </section>
    )
  }
</>
